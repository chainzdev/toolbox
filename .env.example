# Optional. Both fall back to the values in lib/supabase/config.ts, which are
# public by design — RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public origin, used for metadataBase, canonical URLs, sitemap and
# robots. On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL; set it
# explicitly once a custom domain is attached.
NEXT_PUBLIC_SITE_URL=

# Billing (see README > "Turning on billing and monitoring")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Shared secret between the server (webhook + cron routes) and the
# security-definer RPCs. GENERATED IN THE DATABASE by migration 0004 and read
# once from public.app_secret_handover — never commit a value here.
INTERNAL_RPC_SECRET=

# Read automatically by Vercel Cron; also what /api/cron/rescan checks the
# Authorization header against. Generate with: openssl rand -hex 24
CRON_SECRET=
